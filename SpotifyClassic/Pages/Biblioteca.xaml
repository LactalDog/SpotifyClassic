<phone:PhoneApplicationPage 
    x:Class="SpotifyClassic.Biblioteca"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:converters="clr-namespace:SpotifyClassic.Converters"
    mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="768"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0.0"
    shell:SystemTray.BackgroundColor="Transparent">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileFeatherTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileFeatherTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileFeatherTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileFeatherTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <phone:PhoneApplicationPage.Resources>
        <converters:GroupToBackgroundBrushValueConverter x:Key="BackgroundConverter"/>
        <converters:GroupToForegroundBrushValueConverter x:Key="ForegroundConverter"/>

        <Style x:Key="JumpListStyle" TargetType="phone:LongListSelector">
            <Setter Property="Margin" Value="12,6,0,0"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource BackgroundConverter}}"
                                Margin="6" toolkit:TiltEffect.IsTiltEnabled="True"
                                toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                            <TextBlock Text="{Binding Key}" 
                                       FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                                       FontSize="48" Margin="12,0,0,0"
                                       Foreground="{Binding Converter={StaticResource ForegroundConverter}}" 
                                       VerticalAlignment="Bottom"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="LayoutMode" Value="Grid"/>
            <Setter Property="GridCellSize" Value="111,111"/>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">

        <!-- QUITADO: El FeatheringIndex="0" del Pivot -->
        <phone:Pivot x:Name="MainPivot" Title="BIBLIOTECA" toolkit:TurnstileFeatherEffect.FeatheringIndex="1">

            <phone:PivotItem Header="playlists">
                <Grid/>
            </phone:PivotItem>

            <phone:PivotItem Header="álbumes">
                <Grid>
                    <TextBlock x:Name="txtVacioAlbumes" 
                               Text="No tienes álbumes guardados." 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Style="{StaticResource PhoneTextSubtleStyle}" 
                               Visibility="Collapsed"
                               toolkit:TurnstileFeatherEffect.FeatheringIndex="1" />

                    <!-- AGREGADO: SelectionChanged -->
                    <phone:LongListSelector x:Name="lstAlbumes"
                                            IsGroupingEnabled="true" 
                                            HideEmptyGroups="true"
                                            ItemsSource="{Binding AlbumesAgrupados}"
                                            JumpListStyle="{StaticResource JumpListStyle}"
                                            SelectionChanged="lstAlbumes_SelectionChanged"
                                            toolkit:TiltEffect.IsTiltEnabled="True">

                        <phone:LongListSelector.GroupHeaderTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Margin="12,8,0,8"
                                        toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                    <Border Background="{StaticResource SpotifyAccentBrush}"
                                            Padding="8,0,0,0" Width="62" Height="62"                
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" 
                                                   Foreground="#FFFFFF" FontSize="48"
                                                   FontFamily="{StaticResource PhoneFontFamilySemiLight}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </phone:LongListSelector.GroupHeaderTemplate>

                        <phone:LongListSelector.ItemTemplate>
                            <DataTemplate>
                                <!-- QUITADO: El evento Tap directo del Grid -->
                                <Grid Margin="12,8,0,8" Background="Transparent" 
                                      toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="Portada" Width="150" Height="150" Source="{Binding Portada}" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                        <TextBlock x:Name="Titulo" Text="{Binding Titulo}" Style="{StaticResource PhoneTextLargeStyle}" FontFamily="{StaticResource PhoneFontFamilySemiLight}" TextWrapping="Wrap" Margin="0" LineStackingStrategy="BlockLineHeight" LineHeight="33" MaxHeight="66"/>
                                        <TextBlock x:Name="Artista" Text="{Binding Artista}" Style="{StaticResource PhoneTextNormalStyle}" Margin="0" FontFamily="{StaticResource PhoneFontFamilySemiLight}" LineStackingStrategy="BlockLineHeight">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{StaticResource PhoneTextMidContrastColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </phone:LongListSelector.ItemTemplate>
                    </phone:LongListSelector>
                </Grid>
            </phone:PivotItem>

            <phone:PivotItem Header="me gusta">
                <Grid/>
            </phone:PivotItem>

            <phone:PivotItem Header="artistas">
                <Grid/>
            </phone:PivotItem>

        </phone:Pivot>
    </Grid>
</phone:PhoneApplicationPage>