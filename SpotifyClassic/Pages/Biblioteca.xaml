<phone:PhoneApplicationPage 
    x:Class="SpotifyClassic.Biblioteca"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:converters="clr-namespace:SpotifyClassic.Converters"
    mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="768"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0.0"
    shell:SystemTray.BackgroundColor="Transparent">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileFeatherTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileFeatherTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <!-- CLAVE: Salir de la biblioteca de forma sólida para no colapsar el Pivot -->
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <phone:PhoneApplicationPage.Resources>
        <converters:GroupToBackgroundBrushValueConverter x:Key="BackgroundConverter"/>
        <converters:GroupToForegroundBrushValueConverter x:Key="ForegroundConverter"/>

        <Style x:Key="JumpListStyle" TargetType="phone:LongListSelector">
            <Setter Property="Margin" Value="12,6,0,0"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource BackgroundConverter}}"
                                Margin="6" toolkit:TiltEffect.IsTiltEnabled="True"
                                toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                            <TextBlock Text="{Binding Key}" 
                                       FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                                       FontSize="48" Margin="12,0,0,0"
                                       Foreground="{Binding Converter={StaticResource ForegroundConverter}}" 
                                       VerticalAlignment="Bottom"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="LayoutMode" Value="Grid"/>
            <Setter Property="GridCellSize" Value="111,111"/>
        </Style>
        <DataTemplate x:Key="DataTemplate1">
            <Grid Height="70"/>
        </DataTemplate>
        <DataTemplate x:Key="DataTemplate2">
            <Grid Height="70"/>
        </DataTemplate>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PhoneBackgroundBrush}">

        <phone:Pivot x:Name="MainPivot" Title="BIBLIOTECA" toolkit:TurnstileFeatherEffect.FeatheringIndex="0">

            <phone:PivotItem x:Name="Playlists" Header="playlists">
                <Grid>
                    <TextBlock x:Name="txtVacioPlaylists" 
                   Text="No tienes playlists guardadas." 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Style="{StaticResource PhoneTextSubtleStyle}" 
                   Visibility="Collapsed"
                   toolkit:TurnstileFeatherEffect.FeatheringIndex="1" toolkit:SlideInEffect.LineIndex="1" FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>

                    <phone:LongListSelector x:Name="lstPlaylists"
                                IsGroupingEnabled="true" 
                                HideEmptyGroups="true"
                                ItemsSource="{Binding PlaylistsAgrupadas}"
                                JumpListStyle="{StaticResource JumpListStyle}"
                                SelectionChanged="lstPlaylists_SelectionChanged"
                                toolkit:TiltEffect.IsTiltEnabled="True" ListFooterTemplate="{StaticResource DataTemplate2}">

                        <phone:LongListSelector.GroupHeaderTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Margin="12,8,0,8"
                            toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                    <Border Background="{StaticResource SpotifyAccentBrush}"
                                Padding="8,0,0,0" Width="62" Height="62"                
                                HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" 
                                       Foreground="#FFFFFF" FontSize="48"
                                       FontFamily="{StaticResource PhoneFontFamilySemiLight}"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </phone:LongListSelector.GroupHeaderTemplate>

                        <phone:LongListSelector.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8,0,8" Background="Transparent" 
                          toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="Portada" Width="150" Height="150" Source="{Binding Portada}" VerticalAlignment="Top" toolkit:SlideInEffect.LineIndex="1"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                        <TextBlock x:Name="Titulo" Text="{Binding Titulo}" Style="{StaticResource PhoneTextLargeStyle}" FontFamily="{StaticResource PhoneFontFamilySemiLight}" TextWrapping="Wrap" Margin="0" LineStackingStrategy="BlockLineHeight" LineHeight="33" MaxHeight="66" toolkit:SlideInEffect.LineIndex="2"/>
                                        <!-- Cambiamos Artista por Creador -->
                                        <TextBlock x:Name="Creador" Text="{Binding Creador}" Style="{StaticResource PhoneTextNormalStyle}" Margin="0" FontFamily="{StaticResource PhoneFontFamilySemiLight}" LineStackingStrategy="BlockLineHeight" toolkit:SlideInEffect.LineIndex="3">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{StaticResource PhoneTextMidContrastColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </phone:LongListSelector.ItemTemplate>
                    </phone:LongListSelector>
                </Grid>
            </phone:PivotItem>

            <phone:PivotItem x:Name="Albumes" Header="álbumes">
                <Grid>
                    <TextBlock x:Name="txtVacioAlbumes" 
                               Text="No tienes álbumes guardados." 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Style="{StaticResource PhoneTextSubtleStyle}" 
                               Visibility="Collapsed"
                               toolkit:TurnstileFeatherEffect.FeatheringIndex="1" toolkit:SlideInEffect.LineIndex="1" FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>

                    <!-- AGREGADO: SelectionChanged -->
                    <phone:LongListSelector x:Name="lstAlbumes"
                                            IsGroupingEnabled="true" 
                                            HideEmptyGroups="true"
                                            ItemsSource="{Binding AlbumesAgrupados}"
                                            JumpListStyle="{StaticResource JumpListStyle}"
                                            SelectionChanged="lstAlbumes_SelectionChanged"
                                            toolkit:TiltEffect.IsTiltEnabled="True">

                        <phone:LongListSelector.GroupHeaderTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Margin="12,8,0,8"
                                        toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                    <Border Background="{StaticResource SpotifyAccentBrush}"
                                            Padding="8,0,0,0" Width="62" Height="62"                
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" 
                                                   Foreground="#FFFFFF" FontSize="48"
                                                   FontFamily="{StaticResource PhoneFontFamilySemiLight}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </phone:LongListSelector.GroupHeaderTemplate>

                        <phone:LongListSelector.ItemTemplate>
                            <DataTemplate>
                                <!-- QUITADO: El evento Tap directo del Grid -->
                                <Grid Margin="12,8,0,8" Background="Transparent" 
                                      toolkit:TurnstileFeatherEffect.FeatheringIndex="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="Portada" Width="150" Height="150" Source="{Binding Portada}" VerticalAlignment="Top" toolkit:SlideInEffect.LineIndex="1"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                        <TextBlock x:Name="Titulo" Text="{Binding Titulo}" Style="{StaticResource PhoneTextLargeStyle}" FontFamily="{StaticResource PhoneFontFamilySemiLight}" TextWrapping="Wrap" Margin="0" LineStackingStrategy="BlockLineHeight" LineHeight="33" MaxHeight="66" toolkit:SlideInEffect.LineIndex="2"/>
                                        <TextBlock x:Name="Artista" Text="{Binding Artista}" Style="{StaticResource PhoneTextNormalStyle}" Margin="0" FontFamily="{StaticResource PhoneFontFamilySemiLight}" LineStackingStrategy="BlockLineHeight" toolkit:SlideInEffect.LineIndex="3">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{StaticResource PhoneTextMidContrastColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </phone:LongListSelector.ItemTemplate>
                    </phone:LongListSelector>
                </Grid>
            </phone:PivotItem>

            <phone:PivotItem x:Name="canciones" Header="me gusta">
                <!-- Asegúrate de tener referenciado el namespace 'toolkit' -->
                <toolkit:LongListMultiSelector x:Name="ListaCancionesMeGusta"
                                   ItemsSource="{Binding CancionesMeGustaAgrupadas}"
                                   IsGroupingEnabled="True"
                                   HideEmptyGroups="True"
                                   JumpListStyle="{StaticResource JumpListStyle}"
                                   SelectionChanged="ListaCancionesMeGusta_SelectionChanged"
                                   IsSelectionEnabledChanged="ListaCancionesMeGusta_IsSelectionEnabledChanged"
                                   toolkit:TiltEffect.IsTiltEnabled="True" ListFooterTemplate="{StaticResource DataTemplate1}">

                    <!-- AGREGADO: Plantilla idéntica a la de álbumes para las letras de grupo -->
                    <toolkit:LongListMultiSelector.GroupHeaderTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Margin="12,8,0,8"
                        toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                <Border Background="{StaticResource SpotifyAccentBrush}"
                            Padding="8,0,0,0" Width="62" Height="62"                
                            HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Key}" 
                                   Foreground="#FFFFFF" FontSize="48"
                                   FontFamily="{StaticResource PhoneFontFamilySemiLight}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </toolkit:LongListMultiSelector.GroupHeaderTemplate>

                    <toolkit:LongListMultiSelector.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="-12,8,0,8" toolkit:TurnstileFeatherEffect.FeatheringIndex="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="Portada" Width="62" Height="62" Source="{Binding Portada}" toolkit:SlideInEffect.LineIndex="1"/>
                                <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource PhoneTextExtraLargeStyle}" toolkit:SlideInEffect.LineIndex="2" FontSize="{StaticResource PhoneFontSizeLarge}" FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>
                                    <TextBlock Text="{Binding Artista}" Style="{StaticResource PhoneTextSubtleStyle}" toolkit:SlideInEffect.LineIndex="3" FontSize="{StaticResource PhoneFontSizeNormal}" FontFamily="{StaticResource PhoneFontFamilySemiLight}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource PhoneTextMidContrastColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </toolkit:LongListMultiSelector.ItemTemplate>

                </toolkit:LongListMultiSelector>
            </phone:PivotItem>

            <phone:PivotItem x:Name="Artistas" Header="artistas">
                <Grid>
                    <TextBlock x:Name="txtVacioArtistas" 
                   Text="No sigues a ningún artista." 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Style="{StaticResource PhoneTextSubtleStyle}" 
                   Visibility="Collapsed"
                   toolkit:TurnstileFeatherEffect.FeatheringIndex="1" toolkit:SlideInEffect.LineIndex="1" FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>

                    <phone:LongListSelector x:Name="lstArtistas"
                                IsGroupingEnabled="true" 
                                HideEmptyGroups="true"
                                ItemsSource="{Binding ArtistasAgrupados}"
                                JumpListStyle="{StaticResource JumpListStyle}"
                                SelectionChanged="lstArtistas_SelectionChanged"
                                toolkit:TiltEffect.IsTiltEnabled="True">

                        <phone:LongListSelector.GroupHeaderTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Margin="12,8,0,8"
                            toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                    <Border Background="{StaticResource SpotifyAccentBrush}"
                                Padding="8,0,0,0" Width="62" Height="62"                
                                HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" 
                                       Foreground="#FFFFFF" FontSize="48"
                                       FontFamily="{StaticResource PhoneFontFamilySemiLight}"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </phone:LongListSelector.GroupHeaderTemplate>

                        <phone:LongListSelector.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8,0,8" Background="Transparent" 
                          toolkit:TurnstileFeatherEffect.FeatheringIndex="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Imagen del artista -->
                                    <Image Width="62" Height="62" Source="{Binding Portada}" VerticalAlignment="Center" toolkit:SlideInEffect.LineIndex="1"/>

                                    <!-- Solo el nombre, centrado verticalmente, con el estilo de fuente grande -->
                                    <TextBlock Grid.Column="1" Text="{Binding Nombre}" Style="{StaticResource PhoneTextExtraLargeStyle}" FontFamily="{StaticResource PhoneFontFamilySemiLight}" Margin="15,0,0,0" VerticalAlignment="Center" toolkit:SlideInEffect.LineIndex="2" FontSize="36"/>
                                </Grid>
                            </DataTemplate>
                        </phone:LongListSelector.ItemTemplate>
                    </phone:LongListSelector>
                </Grid>
            </phone:PivotItem>

        </phone:Pivot>
    </Grid>
</phone:PhoneApplicationPage>