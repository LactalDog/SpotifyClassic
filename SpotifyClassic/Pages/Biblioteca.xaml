<phone:PhoneApplicationPage
    x:Class="SpotifyClassic.Biblioteca"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:converters="clr-namespace:SpotifyClassic.Converters"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d"
    toolkit:TiltEffect.IsTiltEnabled="True">

    <phone:PhoneApplicationPage.Resources>
        <converters:GroupToBackgroundBrushValueConverter x:Key="GroupBackgroundConverter"/>
        <converters:GroupToForegroundBrushValueConverter x:Key="GroupForegroundConverter"/>

        <!-- Plantilla del ítem individual de Álbum -->
        <DataTemplate x:Key="AlbumItemTemplate">
            <Grid Margin="0,0,0,18" Tap="ItemAlbum_Tap" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Contenedor con tamaño explícito para la portada -->
                <Border Width="62" Height="62" Background="{StaticResource PhoneChromeBrush}" Margin="12,0,12,0">
                    <Image Source="{Binding Portada}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource PhoneTextLargeStyle}" Margin="0" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Artista}" Style="{StaticResource PhoneTextSubtleStyle}" Margin="0" TextTrimming="WordEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Plantilla de la cabecera de grupo en la lista principal -->
        <DataTemplate x:Key="AlbumGroupHeaderTemplate">
            <Border Background="Transparent" Padding="12,8,0,8">
                <Border Background="{StaticResource PhoneAccentBrush}" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center" 
                        Width="48" Height="48" 
                        Margin="0,0,18,0">
                    <TextBlock Text="{Binding Key}" 
                               Foreground="White" 
                               FontSize="28" 
                               FontFamily="{StaticResource PhoneFontFamilySemiBold}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
            </Border>
        </DataTemplate>

        <!-- Estilo del Jump List (selector emergente en cuadrícula alfabética) -->
        <Style x:Key="AlbumJumpListStyle" TargetType="phone:LongListSelector">
            <Setter Property="LayoutMode" Value="Grid" />
            <Setter Property="GridCellSize" Value="113,113"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource GroupBackgroundConverter}}" 
                                Margin="6" 
                                Width="99" 
                                Height="99">
                            <TextBlock Text="{Binding Key}" 
                                       FontFamily="{StaticResource PhoneFontFamilySemiBold}" 
                                       FontSize="36" 
                                       Padding="6" 
                                       Foreground="{Binding Converter={StaticResource GroupForegroundConverter}}" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <phone:Pivot x:Name="MainPivot" Title="SPOTIFY">
            <!-- Playlists -->
            <phone:PivotItem Header="playlists">
                <Grid />
            </phone:PivotItem>

            <!-- Álbumes: LongListSelector Agrupado con Jump List del Toolkit -->
            <phone:PivotItem Header="álbumes">
                <Grid>
                    <TextBlock x:Name="txtVacioAlbumes"
                               Text="no hay álbumes disponibles"
                               Style="{StaticResource PhoneTextSubtleStyle}"
                               Visibility="Collapsed"
                               VerticalAlignment="Top"
                               Margin="24,24,0,0"/>

                    <phone:LongListSelector
                        x:Name="lstAlbumes"
                        ItemsSource="{Binding AlbumesAgrupados}"
                        IsGroupingEnabled="True"
                        HideEmptyGroups="True"
                        ItemTemplate="{StaticResource AlbumItemTemplate}"
                        GroupHeaderTemplate="{StaticResource AlbumGroupHeaderTemplate}"
                        JumpListStyle="{StaticResource AlbumJumpListStyle}"/>
                </Grid>
            </phone:PivotItem>

            <!-- Me gusta -->
            <phone:PivotItem Header="me gusta">
                <Grid />
            </phone:PivotItem>

            <!-- Artistas -->
            <phone:PivotItem Header="artistas">
                <Grid />
            </phone:PivotItem>
        </phone:Pivot>
    </Grid>

</phone:PhoneApplicationPage>